# Entorno común de la batería de contrato. Lo cargan los dos servidores (Node y Laravel).
# Todo apunta a servicios locales del stack de contrato: ni Neon, ni DeepSeek real, ni correo real.
# DATABASE_URL la pone cada compose (cambia el host de la base).

APP_URL=http://localhost:8080
ALLOWED_ORIGINS=https://permitido.example
TRUST_PROXY=1

MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Ruta contrato <contrato@smoke.test>

DEEPSEEK_URL=http://fake-deepseek:8790/chat/completions
DEEPSEEK_API_KEY=contract-fake-key

ADMIN_TOKEN=contract-admin-token
IP_PEPPER=contract-pepper
