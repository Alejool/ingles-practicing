# ─── Copia a .env (local) o ponlas como variables de entorno del sitio ───

# Base de datos PostgreSQL. Neon da una gratis: https://neon.tech
DATABASE_URL=postgresql://usuario:clave@ep-xxx.neon.tech/neondb?sslmode=require

# ¿Sin ganas de crear una base todavía? Deja DATABASE_URL vacía y pon esto:
# la base pasa a ser una carpeta de tu disco (Postgres compilado a WASM, mismo
# SQL). Sirve para tu máquina y para un VPS con un solo proceso; NO para Netlify
# ni Vercel, donde el disco se borra en cada llamada. Cuando quieras cambiarte a
# una base de verdad: copia, pon DATABASE_URL y restaura. No se toca ni una consulta.
# DB_DRIVER=pglite
# PGLITE_DIR=./data/pglite

# La clave de DeepSeek. NUNCA va en el frontend.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# URL pública de la app. Se usa para construir el enlace mágico.
APP_URL=https://ruta.tudominio.com

# Orígenes permitidos, separados por comas. Con el front y la API en el mismo
# sitio de Netlify no hace falta tocarlo; si los separas, ponlo exacto.
ALLOWED_ORIGINS=https://ruta.tudominio.com

# Pimienta para el hash de las IP. Cualquier cadena larga y secreta.
# Si la cambias, las cuotas anónimas por IP se reinician.
IP_PEPPER=cambia-esto-por-algo-largo-y-aleatorio

# Correo del enlace mágico. resend | postmark | log
# "log" no envía nada: escribe el enlace en los logs de la función (solo desarrollo).
MAIL_PROVIDER=resend
MAIL_FROM=Ruta B1→B2 <acceso@tudominio.com>
RESEND_API_KEY=re_xxxxxxxx
# POSTMARK_TOKEN=xxxxxxxx

# Token para /api/admin y para /admin.html. Sin él, ese endpoint responde 404.
ADMIN_TOKEN=otra-cadena-larga-y-secreta

# ─── Estadísticas anónimas ────────────────────────────────────────────
# El latido diario: día del plan, días hechos, racha, ruta y módulos abiertos.
# Ni correo, ni id de cuenta, ni IP: la clave es un hash con IP_PEPPER del id de
# dispositivo. Sirve para saber en qué día abandona la gente. Ponlo a false y el
# endpoint deja de guardar nada (cada persona también puede apagarlo en Ajustes).
PULSE_ENABLED=true

# ─── Copias de seguridad ──────────────────────────────────────────────
# Carpeta y cuántas copias conservar en 'bash start.sh backup'.
BACKUP_DIR=backups
BACKUP_KEEP=14

# ─── Cuotas ───────────────────────────────────────────────────────────
# La unidad es el CRÉDITO, no la llamada: un writing largo cuesta varias veces
# un open cloze y se cobra en consecuencia. Un crédito equivale al coste de una
# corrección normal, en millonésimas de dólar.
# Con este valor, un hueco de Use of English cuesta 1 crédito, una corrección
# de writing unos 3, un texto largo 6 y el modelo que razona el doble.
QUOTA_CREDIT_MICROS=500
# Sin cuenta: créditos totales por dispositivo (y por IP). 15 ≈ cinco correcciones.
QUOTA_ANON_LIFETIME=15
QUOTA_ANON_IP_WINDOW_DAYS=30
# Con cuenta. 60 al día ≈ veinte correcciones diarias.
QUOTA_USER_DAILY=60
QUOTA_USER_MONTHLY=900
# Techo diario de todo el despliegue, en créditos (6000 ≈ 3 USD).
QUOTA_GLOBAL_DAILY=6000
# Y el techo que de verdad evita la factura sorpresa: dólares al día.
# Al llegar aquí la IA se apaga hasta mañana. Ponlo a 0 para no usarlo.
QUOTA_GLOBAL_DAILY_USD=3
# Ritmo máximo por dispositivo o IP.
QUOTA_PER_MINUTE=6
# Tope de tokens de respuesta por llamada.
AI_MAX_TOKENS=2048

# Precios del proveedor, en dólares por millón de tokens. Solo hay que tocarlos
# si DeepSeek cambia su tarifa; se usan para calcular el coste de cada llamada.
PRICE_CHAT_IN=0.27
PRICE_CHAT_OUT=1.10
PRICE_REASONER_IN=0.55
PRICE_REASONER_OUT=2.19

# ─── Sesiones y enlaces ───────────────────────────────────────────────
SESSION_DAYS=60
LOGIN_LINK_MINUTES=15
LOGIN_MAX_PER_EMAIL_HOUR=4
LOGIN_MAX_PER_IP_HOUR=12
PROGRESS_MAX_KB=512

# ─── Solo si sirves el front en otro dominio que la API ───────────────
# PUBLIC_API_BASE=https://api.tudominio.com
