---
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";

import Panel from "../components/views/Panel.astro";
import Exams from "../components/views/Exams.astro";
import Diagnostic from "../components/views/Diagnostic.astro";
import Plan from "../components/views/Plan.astro";
import Grammar from "../components/views/Grammar.astro";
import Vocab from "../components/views/Vocab.astro";
import Mine from "../components/views/Mine.astro";
import Uoe from "../components/views/Uoe.astro";
import Writing from "../components/views/Writing.astro";
import Reading from "../components/views/Reading.astro";
import Speaking from "../components/views/Speaking.astro";
import Quiz from "../components/views/Quiz.astro";
import Mock from "../components/views/Mock.astro";
import Errors from "../components/views/Errors.astro";
import Tutor from "../components/views/Tutor.astro";
import Resources from "../components/views/Resources.astro";
import Settings from "../components/views/Settings.astro";
import Account from "../components/views/Account.astro";

const title = "Ruta B1 → B2";
const description =
  "Entrenamiento interactivo de inglés A2–B2 para exámenes de certificación: diagnóstico, plan diario de 120 días, gramática, vocabulario por tipo de palabra con repetición espaciada, cuaderno de palabras difíciles, Use of English, writing, speaking con dictado y corrección, biblioteca de lecturas y simulacro cronometrado.";
---

<Base title={title} description={description}>
  <!--
    Guardián de acceso (landing-y-acceso AC-1, plan K-2): se ejecuta antes de
    descargar nada de la app. Sin token ni marcador de cuenta activo, a la
    landing. Es de experiencia, no de seguridad (K-3): lo que cuesta y lo
    personal ya lo protege el servidor.
  -->
  <script is:inline slot="head" define:vars={{ base: import.meta.env.BASE_URL.replace(/\/?$/, "/") }}>
    (function () {
      var h = location.hash;
      var landing = base + "bienvenida/";
      if (h === "#auth=expired" || h === "#auth=error") {
        document.documentElement.dataset.acceso = "fuera";
        location.replace(landing + "#acceso=" + (h === "#auth=expired" ? "caducado" : "error"));
        return;
      }
      if (h.indexOf("#auth=") === 0) return;
      var token = null;
      var cuenta = null;
      try {
        token = localStorage.getItem("ruta-b1b2-session");
        var c = JSON.parse(localStorage.getItem("ruta-b1b2-cuenta") || "null");
        // Misma regla que leerMarcador() de cuenta-local.ts (lo fija tests/guardian.test.mts).
        if (c && c.v === 1 && typeof c.id === "string" && /^[0-9a-f]{16}$/.test(c.id)
          && (c.salida === null || typeof c.salida === "string")) cuenta = c;
      } catch (e) { /* sin almacenamiento = sin sesión */ }
      if (token || (cuenta && cuenta.salida === null)) return;
      // arranque.ts lo lee y no carga la app mientras el navegador se va.
      document.documentElement.dataset.acceso = "fuera";
      location.replace(landing);
    })();
  </script>
  <div class="app">
    <Rail />
    <main class="main" id="main">
      <Panel />
      <Exams />
      <Diagnostic />
      <Plan />
      <Grammar />
      <Vocab />
      <Mine />
      <Uoe />
      <Writing />
      <Reading />
      <Speaking />
      <Quiz />
      <Mock />
      <Errors />
      <Tutor />
      <Resources />
      <Settings />
      <Account />
    </main>
  </div>
</Base>

<script>
  import "../scripts/arranque";
</script>
