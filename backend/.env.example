APP_NAME=Ruta
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Postgres. En el stack docker/ apunta al servicio db; en producción, a Neon.
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://ruta:ruta@db:5432/ruta

# Sin estado en Laravel: ni sesiones, ni caché, ni colas persistentes.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
