{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "_viejo",
    "backups",
    "data",
    ".netlify",
    ".vercel"
  ],
  "compilerOptions": {
    "strictNullChecks": false,
    "verbatimModuleSyntax": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
