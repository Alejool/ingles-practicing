# Interpolación de compose.yml SOLO para desarrollo y la batería de contrato.
# Copia este archivo a docker/local.env (ignorado por git) y genera la clave:
#   cp docker/local.env.example docker/local.env
#   docker run --rm php:8.4-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# Uso: docker compose --env-file docker/local.env -f docker/compose.yml ...
# Producción no usa este archivo: exporta su propia APP_KEY y compose.yml se niega a
# arrancar sin ella (también si queda vacía).
APP_KEY=
